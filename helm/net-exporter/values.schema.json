{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "NetExporter": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "DNSCheck": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "TCP": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "Disabled": {
                                    "type": "boolean"
                                }
                            }
                        }
                    }
                },
                "Hosts": {
                    "type": "string"
                },
                "NTPServers": {
                    "type": "string"
                }
            }
        },
        "baseDomain": {
            "type": "string"
        },
        "bootstrapMode": {
            "type": "object",
            "additionalProperties": true
        },
        "chartOperator": {
            "type": "object",
            "additionalProperties": true
        },
        "ciliumNetworkPolicy": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
                "enabled": {
                    "type": "boolean"
                }
            }
        },
        "cluster": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
                "kubernetes": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "DNS": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "IP": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "clusterCA": {
            "type": "string"
        },
        "clusterCIDR": {
            "type": "string"
        },
        "clusterDNSIP": {
            "type": "string"
        },
        "clusterID": {
            "type": "string"
        },
        "controlPlaneSubnets": {
            "type": "array"
        },
        "daemonset": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "priorityClassName": {
                    "type": "string"
                }
            }
        },
        "dns": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "label": {
                    "type": "string"
                },
                "namespace": {
                    "type": "string"
                },
                "port": {
                    "type": "integer"
                },
                "service": {
                    "type": "string"
                }
            }
        },
        "dnscache": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "port": {
                    "type": "integer"
                }
            }
        },
        "externalDNSIP": {
            "type": "string"
        },
        "gcpProject": {
            "type": "string"
        },
        "global": {
            "type": [
                "object",
                "null"
            ],
            "description": "Global values shared between all subcharts and the platform.",
            "additionalProperties": true,
            "properties": {
                "podSecurityStandards": {
                    "type": "object",
                    "additionalProperties": true
                }
            }
        },
        "groupID": {
            "type": "integer"
        },
        "helm": {
            "type": "object",
            "additionalProperties": true
        },
        "image": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "name": {
                    "type": "string"
                },
                "registry": {
                    "type": "string"
                },
                "tag": {
                    "type": "string"
                }
            }
        },
        "kubectl": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "image": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "name": {
                            "type": "string"
                        },
                        "registry": {
                            "type": "string"
                        },
                        "tag": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "managementCluster": {
            "type": "string"
        },
        "name": {
            "type": "string"
        },
        "podSecurityContext": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "runAsNonRoot": {
                    "type": "boolean"
                },
                "seccompProfile": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "type": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "port": {
            "type": "integer"
        },
        "provider": {
            "type": "string"
        },
        "resources": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "requests": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "cpu": {
                            "type": "string"
                        },
                        "memory": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "securityContext": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "allowPrivilegeEscalation": {
                    "type": "boolean"
                },
                "capabilities": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "drop": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "readOnlyRootFilesystem": {
                    "type": "boolean"
                },
                "seccompProfile": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "type": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "serviceMonitor": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "interval": {
                    "type": "string",
                    "description": "Prometheus scrape interval."
                },
                "scrapeTimeout": {
                    "type": "string",
                    "description": "Prometheus scrape timeout."
                }
            }
        },
        "serviceType": {
            "type": "string"
        },
        "subscriptionID": {
            "type": "string"
        },
        "timeout": {
            "type": "string"
        },
        "userID": {
            "type": "integer"
        },
        "verticalPodAutoscaler": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "maxAllowed": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "memory": {
                            "type": "string"
                        }
                    }
                },
                "minAllowed": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "cpu": {
                            "type": "string"
                        },
                        "memory": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    }
}
